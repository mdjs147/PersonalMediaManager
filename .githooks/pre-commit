#!/usr/bin/env bash
set -euo pipefail
case "${PMM_OPERATION:-implementation}" in
  implementation)
    python3 scripts/pmm_governance.py commit --actor "${PMM_ACTOR:?Set actual actor}" --execution "${PMM_EXECUTION:?Set actual execution}" --purpose "${PMM_PURPOSE:?Set published purpose}"
    ;;
  plan)
    python3 "${PMM_TRUSTED_CONTROLLER:?Export controller from old stage}" prepare-plan --root "$PWD" --old-sha "${PMM_OLD_SHA:?Set observed stage}" --plan "${PMM_PLAN:?Set plan path}" --actor "${PMM_ACTOR:?}" --execution "${PMM_EXECUTION:?}"
    ;;
  activate)
    python3 "${PMM_TRUSTED_CONTROLLER:?Export controller from old stage}" prepare-activation --root "$PWD" --old-sha "${PMM_OLD_SHA:?Set observed stage}" --actor "${PMM_ACTOR:?}" --execution "${PMM_EXECUTION:?}"
    ;;
  *) echo 'Unknown PMM_OPERATION' >&2; exit 1 ;;
esac
