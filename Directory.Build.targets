<Project>

  <!-- 产品版本来自 props 单一声明；程序集兼容字段自动派生，commit 只作构建诊断。 -->
  <Target Name="ValidatePmmProductVersion" BeforeTargets="PrepareForBuild;GetAssemblyVersion">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)Directory.Build.props"
             Query="/Project/PropertyGroup/PmmProductVersion/text()">
      <Output TaskParameter="Result" ItemName="_PmmDeclaredVersions" />
    </XmlPeek>
    <PropertyGroup>
      <_PmmDeclaredProductVersion>@(_PmmDeclaredVersions)</_PmmDeclaredProductVersion>
      <_PmmDeclaredProductVersion>$([System.String]::Copy('$(_PmmDeclaredProductVersion)').Trim())</_PmmDeclaredProductVersion>
      <_PmmVersionWellFormed>$([System.Text.RegularExpressions.Regex]::IsMatch('$(PmmProductVersion)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))</_PmmVersionWellFormed>
      <_PmmInformationalCore>$([System.Text.RegularExpressions.Regex]::Match('$(InformationalVersion)', '^[^+]+').Value)</_PmmInformationalCore>
    </PropertyGroup>
    <Error Condition=" '@(_PmmDeclaredVersions->Count())' != '1' Or '$(_PmmVersionWellFormed)' != 'True' "
           Text="Directory.Build.props 必须且只能声明一个 X.Y.Z 主版本，不支持预发行或构建后缀。" />
    <Error Condition=" '$(PmmProductVersion)' != '$(_PmmDeclaredProductVersion)' Or '$(VersionPrefix)' != '$(PmmProductVersion)' Or '$(Version)' != '$(PmmProductVersion)' Or '$(AssemblyVersion)' != '$(PmmProductVersion).0' Or '$(FileVersion)' != '$(PmmProductVersion).0' "
           Text="版本只能在 Directory.Build.props 的 PmmProductVersion 维护，禁止独立覆盖产品、程序集或后端版本。" />
    <Error Condition=" '$(InformationalVersion)' != '' And '$(_PmmInformationalCore)' != '$(PmmProductVersion)' "
           Text="InformationalVersion 的产品版本必须与唯一主版本一致。" />
  </Target>

  <Target Name="StampGitVersion"
          BeforeTargets="GetAssemblyVersion"
          Condition=" '$(StampGitVersionDisabled)' != 'true' ">

    <!-- 短 sha（rev-parse 取 HEAD 前 8 位 hex） -->
    <Exec Command="git rev-parse --short=8 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PmmGitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_PmmGitShaExit" />
    </Exec>

    <!-- dirty 检测：diff-index 静默对比工作区与 HEAD，ExitCode 0 干净 / 1 有未提交改动 -->
    <Exec Command="git diff-index --quiet HEAD --"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_PmmGitDirtyExit" />
    </Exec>

    <PropertyGroup>
      <!-- Fallback：git 不可用或在解决方案外构建时 -->
      <_PmmGitShortSha Condition=" '$(_PmmGitShortSha)' == '' Or '$(_PmmGitShaExit)' != '0' ">unknown</_PmmGitShortSha>
      <_PmmGitDirtySuffix Condition=" '$(_PmmGitDirtyExit)' == '1' ">.dirty</_PmmGitDirtySuffix>
      <_PmmGitDirtySuffix Condition=" '$(_PmmGitDirtyExit)' != '1' "></_PmmGitDirtySuffix>

      <!-- 注入到 SDK 标准属性 -->
      <FileVersion>$(PmmProductVersion).0</FileVersion>
      <_PmmExpectedInformational>$(PmmProductVersion)+$(_PmmGitShortSha)$(_PmmGitDirtySuffix)</_PmmExpectedInformational>
      <InformationalVersion>$(_PmmExpectedInformational)</InformationalVersion>
    </PropertyGroup>
    <Error Condition=" '$(InformationalVersion)' != '$(_PmmExpectedInformational)' "
           Text="InformationalVersion 由主版本和当前提交自动生成，禁止独立覆盖。" />

    <Message Text="[StampGitVersion] $(MSBuildProjectName) → FileVersion=$(FileVersion) InformationalVersion=$(InformationalVersion)"
             Importance="low" />
  </Target>

  <!-- FrontendVersion 仅作为旧调用方兼容元数据，不再读取或维护独立前端版本。 -->
  <Target Name="InjectVersionMetadata" BeforeTargets="GetAssemblyAttributes"
          Condition=" '$(InjectVersionMetadataDisabled)' != 'true' ">
    <PropertyGroup>
      <_PmmBuildTimeUtc>$([System.DateTime]::UtcNow.ToString('o'))</_PmmBuildTimeUtc>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ProductVersion</_Parameter1>
        <_Parameter2>$(PmmProductVersion)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>FrontendVersion</_Parameter1>
        <_Parameter2>$(PmmProductVersion)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimeUtc</_Parameter1>
        <_Parameter2>$(_PmmBuildTimeUtc)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
    <Message Text="[InjectVersionMetadata] $(MSBuildProjectName) → Product=$(PmmProductVersion) BuildTimeUtc=$(_PmmBuildTimeUtc)" Importance="low" />
  </Target>
</Project>
