<Project>

  <!--
    PersonalMediaManager 解决方案全局 MSBuild 属性
    所有 src/* 与 tests/* 项目自动继承本文件
  -->

  <PropertyGroup>
    <!-- 统一目标框架（Launcher 及其测试工程在自身 csproj 覆盖为 net10.0-windows） -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>

    <!-- 严格模式：开启可空、警告即错误 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- IDE0055 在 .editorconfig 已降为 suggestion；此处保留豁免列表防回归 -->
    <WarningsNotAsErrors>IDE0055</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- 输出确定性，便于跨平台一致 hash -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <!-- 中文注释/字符串源码统一 UTF-8 -->
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <!-- 公司元数据（产物 metadata） -->
    <Company>PersonalMediaManager</Company>
    <Product>PersonalMediaManager</Product>
    <Authors>PersonalMediaManager Team</Authors>
    <Copyright>© 2026 PersonalMediaManager</Copyright>

    <!--
      版本号（CLAUDE.md §五/§十二 全栈贯穿）

      四个版本号 三套刻度：
        · PmmProductVersion = 主版本号（对外展示）            — 仅发版升，与 git tag 1:1
        · VersionPrefix     = 后端版本号（.NET 程序集 SemVer） — 后端代码合 main 时升
        · PmmDbVersion      = 数据库目标 schema 版本号         — 新增 EF migration 时升
        · FrontendVersion   = 前端版本号（src/PersonalMediaManager.Frontend/package.json:version）
                              由 Directory.Build.targets 构建期读 package.json 注入 assembly metadata
      （前端版本号不在本文件维护；前端开发者用 npm version patch 升 package.json，注意带 no-git-tag-version 选项避免自动 tag）

      为何加 Pmm 前缀：`ProductVersion` / `DbVersionPrefix` 等不带前缀的属性名与
      Microsoft.NET.Sdk 内部属性冲突（实测会破坏 TargetFramework 推断 → NETSDK1013），
      用 Pmm 前缀做隔离。

      SemVer（0.x 阶段简化语义）：
        · MAJOR：1.0 之前不动；1.0 之后保留给真正破坏性变更
        · MINOR：新增功能 / 新 API / 新增 migration（db）
        · PATCH：bug 修复 / 文案 / 内部重构
        · 1.0 前用 0.x（接口不稳定阶段，PMM 当前所处）

      VersionPrefix 自动字段（由 Directory.Build.targets StampGitVersion 注入）：
        · FileVersion           = $(VersionPrefix).{git commit 数}  — 4 段，给运维定位回滚用
        · InformationalVersion  = $(VersionPrefix)+{short sha}[.dirty]  — 后端版本号 + commit
        · AssemblyVersion        保留 SDK 默认（$(VersionPrefix).0），跨 commit 不抖动 ABI

      PmmProductVersion / PmmDbVersion / FrontendVersion / BuildTimeUtc 通过
      AssemblyMetadataAttribute 烤进 entry assembly（详见 Directory.Build.targets InjectVersionMetadata target），
      运行时由 SystemService 反射读出供 /system/version 与 /system/info 返回。

      关闭 SDK 默认的 SourceRevisionId 自动追加，避免与 StampGitVersion 产出的 +sha 重复
    -->
    <!-- 2026-06-11 版本号重置：开发期历史演进随仓库迁移整合为 0.1.0 基线（四套版本号自最初版重新开始），整合记录见 CHANGELOG.md -->
    <!-- 2026-06-12 字幕下载功能：后端/数据库/前端升 0.2.0（新 migration AddSubtitleTables）；产品版本号仅发版升，保持不动 -->
    <!-- 2026-06-13 空目录清理：后端/数据库升 0.3.0（新 migration CleanEmptyDirIgnoreExtsSeed + File.CleanEmptyDir 接线消费）；前端无改动、产品版本号不动 -->
    <!-- 2026-06-13 AI 供应商超时设置：前端补超时输入框 + 放宽解析/对话链路总超时与测试连接硬钳，让 Ollama 冷启动可配大超时；后端升 0.3.1、前端升 0.2.2；无 migration（TimeoutSeconds 列早已存在）、产品版本号不动 -->
    <!-- 2026-06-18 Anthropic 协议错误体诊断：HTTP 200 错误体/空 content 改抛真实错误文案（兼容中转代理 {"error":{...}}）+ 把响应原文塞 Exception.Data 落 Audit_AiCall.ResponseText/测试连接展示；后端升 0.3.2；无 migration、前端/产品版本号不动 -->
    <!-- 2026-06-18 BaseUrl 智能去重：JoinUrl 按路径段重叠去重（容忍多填 /v1 / 整条端点 / 大小写 / 尾斜杠 + 保留中转前缀）；前端 AI 提供商页补每协议 BaseUrl 说明 + 实际请求 URL 实时预览；后端升 0.3.3、前端升 0.2.3；无 migration、产品版本号不动 -->
    <!-- 2026-06-18 BaseUrl 版本槽合并：JoinUrl 增「两端均版本号段但不同→保用户显式版本」（第三方常要求带 /v1，且支持 /v2 /openai/v1 等不强塞 v1）；前端预览同步复刻 + 文案强调原样保留；后端升 0.3.4、前端升 0.2.4；无 migration、产品版本号不动 -->
    <!-- 2026-06-18 AI 提供商快速预设：前端 AI 提供商新增页加 10 个常用厂商一键预设（OpenRouter/DeepSeek/硅基流动/百炼/智谱GLM/Kimi/OpenAI/Claude/Gemini/Ollama，点选自动填协议+地址+模型）+ 刷新 Anthropic 默认模型占位；纯前端升 0.2.5；后端/数据库/产品版本号不动 -->
    <!-- 2026-06-18 Anthropic 测试连接假阴性：连通性探测 MaxTokens 由 1 提到 16（Claude 在 max_tokens=1 时会在产出内容块前撞上限，回 content:[]+stop_reason=max_tokens，被协议层误判「AI 响应缺少 content」，端点其实已鉴权/路由/跑通模型）；后端升 0.3.5；无 migration、前端/产品版本号不动 -->
    <!-- 2026-06-18 强制匹配标识（pmm.txt / TMDB URL）：文件夹放 pmm.txt 贴 TMDB 网址即强制锚定指定条目，跳过规则与 AI 自主判断；支持剧集组（episode_group）把重制版编组内集号翻译成正典季集（高达 SEED HD Remaster 等）；新增 ITmdbClient.GetEpisodeGroupAsync + IForcedMatchMarkerStore；后端升 0.3.6；前端加「强制匹配」来源标签 + 历史过滤项升 0.2.6；无 migration（剧集组复用搜索缓存表）、产品版本号不动 -->
    <!-- 2026-06-18 强制匹配说明页：识别归类下新增「强制匹配」页（设置/forced-match），展示 pmm.txt 支持的网址形态 + 高级 key=value + 一键下载样例 pmm.txt + 归档落点样例 + Plex 兼容说明；纯静态前端，前端升 0.2.7 -->
    <!-- 2026-06-19 处理历史页批量操作：多选(逐行 + 全选当前页) + 批量重新处理 / 批量删除（复用 useMediaRecordActions 既有 batchReprocess/batchDelete，打 /history/reprocess|delete）+ Admin 权限门禁（批量栏/复选框/逐行写操作仅 Admin，后端全局 FallbackPolicy 同样强制 Admin）；选择仅当前页（翻页/筛选/操作后清空），后端单批上限 500；纯前端升 0.2.8 -->
    <!-- 2026-06-19 修复强制匹配剧集组双集末集未翻译：末集随起始集按编组映射翻译，仅同季且正典跨度==编组内跨度才保留连续区间，乱序/跨季/越界退化单集；后端升 0.3.7 -->
    <!-- 2026-06-19 监控目录自动监控开关：WatchFolder 增 AutoScan（默认 true，新 migration AddWatchFolderAutoScan）——开启走原有自动机制（实时监听 + 周期 FullScan + 网络盘可达性探测），关闭则全部停掉、目录仅在手动点击扫描时处理；手动「立即扫描全部/单目录」不受开关限制。后端/数据库升 0.4.0（新 migration）、前端升 0.3.0；产品版本号不动 -->
    <!-- 2026-06-19 安全修复 SQLite 高危漏洞（CVE-2025-6965 / GHSA-2m69-gcr7-jv3q，SQLite < 3.50.2 聚合项内存破损 CVSS 9.8）：在 Persistence/Platform 及其测试顶层 pin SQLitePCLRaw.lib.e_sqlite3 3.50.3，覆盖 EF Sqlite / Microsoft.Data.Sqlite 推移引入的脆弱 2.1.11（仅换已修复原生库，托管 core 2.1.11 经 C ABI 不变）；后端升 0.4.1；无 migration、前端/产品版本号不动 -->
    <!-- 2026-06-19 强制匹配增文件名/文件夹名 {tmdb-NNN} 标记识别：文件名或文件夹名带 Plex 官方匹配标记即仅锚定 TMDB id，类型/季/集仍由规则引擎正常识别（类型猜反自动翻 tv↔movie 兜底）；与 pmm.txt 共存，优先级 pmm.txt>.url>文件名标记>文件夹名标记。后端升 0.4.3、前端升 0.3.2；无 migration、产品版本号不动 -->
    <!-- 2026-06-19 弹窗遮罩去模糊（性能修复）：移除 .el-overlay 全屏 backdrop-filter:blur(2px)——它与顶栏毛玻璃二重叠加，弹窗开关/输入时逐帧重算整屏致严重卡顿（AI 提供商等字段多的弹窗最明显）；半透明暗幕保留模态层级。全站 el-dialog/el-message-box/el-drawer 共用此类，一处即全部生效。纯前端升 0.3.3；后端/数据库/产品版本号不动 -->
    <!-- 2026-06-19 不兼容音频(av3a Audio Vivid)处理：归档前 ffprobe 探测音轨 codec，含 av3a 等不兼容轨则 History 打标；开启自动重混且存在兼容音轨时用 ffmpeg 流复制丢轨(就近目标盘输出，省一次大文件跨卷重写)。新增 IMediaAudioProbe/IAudioRemuxer 契约(Platform 调外部 ffprobe/ffmpeg，exe 路径由编排层传入、本层不读 DB)、Media_Item 增 AudioCodecs/HasIncompatibleAudio 两列(migration AddAudioProbeFields)、4 个 Audio_* 设置；顺带补登记 version-map 遗漏的 0.4.0→AddWatchFolderAutoScan 行。后端升 0.5.0、数据库升 0.5.0、前端升 0.3.4(接弹窗遮罩 0.3.3 之后)；产品版本号不动 -->
    <!-- 2026-06-19 存量库批量重扫音频打标：媒体库页加「扫描不兼容音轨」按钮 → POST /library/rescan-audio，对未探测过(AudioCodecs==null)的已完成记录逐条 ffprobe 探 TargetPath、回写不兼容音轨标记(仅打标不重混)；新增 MediaItem.RefreshAudioProbe(不守护终态，因 Completed 是终态)、ILibraryService.RescanAudioAsync、AudioRescanResult，抽 AudioProbeSupport 共享 ffprobe 路径/codec 解析供归档探测与存量重扫共用。后端升 0.5.1、前端升 0.3.5；无 migration、数据库/产品版本号不动 -->
    <!-- 2026-06-19 设置页 ffmpeg 下载跳转：常规设置「音频」分组 Audio_FfmpegPath 项旁加「下载 ffmpeg ↗」外链(官方 ffmpeg.org/download.html，新标签打开 + rel=noopener)，引导用户自备 ffmpeg；General.vue 加 SETTING_HELP_LINKS 针对特定 key 的帮助链接映射。纯前端升 0.3.6；后端/数据库/产品版本号不动 -->
    <!-- 2026-06-19 仪表盘加扫描入口：仪表盘页眉加「立即扫描全部 / 强制全扫」按钮 + 「监控目录健康度」各目录卡加「扫描此目录」按钮，把手动扫描从设置/监控目录页搬到更常用的仪表盘；三动作（全量/强制/单目录）抽 useScanActions composable 与监控目录页共用，仪表盘扫完回调 reloadAll 刷新队列数字。纯前端升 0.3.9（接 0.3.8 之后）；后端/数据库/产品版本号不动 -->
    <!-- 2026-06-19 归档命名模板自定义：开放 3 个文件名主体模板（电影 / 剧集根 / 单集）+ 季标题后缀开关，{tmdb-NNN} 锚点 / Season NN 季目录 / SxxEyy 集号 / (year) 年份 / 伴随文件名等刮削必需结构全部锁死不进模板；占位符白名单 {title}{originaltitle}{year}{tmdbid}{edition}{episode}{seasonyear} 各值过 Sanitize；新增 NamingTemplateOptions/Renderer（Application 纯渲染）+ ArchiveNamingTemplateReader（Persistence 读 DB 降级容错）+ 模板穿过 BuildRelativeTargetPath 单咽喉保证「预览=实际落点」+ 4 个 Archive_* 设置 + migration AddArchiveNamingTemplates + 专属页/校验/ProtectedKeys + 预览端点。默认模板 == 改造前硬编码（逐字节回归守住），存量不重整、升级零行为变化。后端升 0.6.0、数据库升 0.6.0（新 migration）、前端升（package.json 单独维护）；产品版本号不动 -->
    <!-- 2026-06-20 ffmpeg 路径自检按钮：常规设置「音频」分组 Audio_FfmpegPath 旁加「测试可用性」按钮 → POST /settings/general/test-ffmpeg，解析路径(目录或 exe)→各跑 ffprobe/ffmpeg -version 验证可启动并取版本首行，工具未配置/缺失/不可执行统一返 200+success=false 携原因(不抛 1000)。新增 IFfmpegToolTester 契约(Platform 跑 -version，仍不读 DB/只按给定 exe 执行)+ FfmpegToolTester + GeneralSettingsService.TestFfmpegAsync(复用 AudioProbeSupport.ResolveFfmpegTools 避免逻辑漂移)。后端升 0.6.1、前端升 0.4.2；无 migration、数据库/产品版本号不动 -->
