<Project>

  <!--
    PersonalMediaManager 解决方案全局 MSBuild 属性
    所有 src/* 与 tests/* 项目自动继承本文件
  -->

  <PropertyGroup>
    <!-- 统一目标框架（Launcher 及其测试工程在自身 csproj 覆盖为 net10.0-windows） -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>

    <!-- 严格模式：开启可空、警告即错误 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- IDE0055 在 .editorconfig 已降为 suggestion；此处保留豁免列表防回归 -->
    <WarningsNotAsErrors>IDE0055</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- 输出确定性，便于跨平台一致 hash -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <!-- 中文注释/字符串源码统一 UTF-8 -->
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <!-- 公司元数据（产物 metadata） -->
    <Company>PersonalMediaManager</Company>
    <Product>PersonalMediaManager</Product>
    <Authors>PersonalMediaManager Team</Authors>
    <Copyright>© 2026 PersonalMediaManager</Copyright>

    <!-- 唯一人工维护的产品版本；“主版本”指完整产品版本，并非只指 SemVer 的 major 位。
         前端 manifest、程序集和安装包均派生此值；数据库只保留 EF 迁移标识。
         历史独立版本演进保存在 CHANGELOG，不再作为构建配置来源。 -->
    <PmmProductVersion>0.4.0</PmmProductVersion>
    <VersionPrefix>$(PmmProductVersion)</VersionPrefix>
    <Version>$(PmmProductVersion)</Version>
    <AssemblyVersion>$(PmmProductVersion).0</AssemblyVersion>
    <FileVersion>$(PmmProductVersion).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- 抑制本项目无意义的告警：xunit 测试方法可能没有参数等 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
