<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure.Persistence：EF Core / SQLite / 仓储实现 / 拦截器 / 迁移
    引用范围：Application + Domain；禁止与 Infrastructure.External / Platform 互引
  -->

  <PropertyGroup>
    <RootNamespace>PersonalMediaManager.Infrastructure.Persistence</RootNamespace>
    <AssemblyName>PersonalMediaManager.Infrastructure.Persistence</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PersonalMediaManager.Application\PersonalMediaManager.Application.csproj" />
    <ProjectReference Include="..\PersonalMediaManager.Domain\PersonalMediaManager.Domain.csproj" />
  </ItemGroup>

  <!--
    db/version-map.json 作为 EmbeddedResource 打包：运行时 Assembly.GetManifestResourceStream 读取，
    避免依赖部署目录文件存在性。资源名称：PersonalMediaManager.Infrastructure.Persistence.version-map.json
    （LogicalName 显式指定，避免目录路径变化导致资源名漂移）
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\version-map.json" LogicalName="PersonalMediaManager.Infrastructure.Persistence.version-map.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PersonalMediaManager.Infrastructure.Persistence.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!--
      安全修复：覆盖 EF Sqlite 推移引入的脆弱原生库 SQLitePCLRaw.lib.e_sqlite3 2.1.11。
      CVE-2025-6965 / GHSA-2m69-gcr7-jv3q：SQLite < 3.50.2 聚合项数量可超列数 → 内存破损（CVSS 9.8 高危）。
      3.50.3 仅替换已修复的 SQLite 原生二进制（runtimes/*/native/e_sqlite3.*）；托管层 SQLitePCLRaw.core 2.1.11
      经稳定的 SQLite C ABI 直接调用新原生库，无需同步升 bundle/core/provider。
      bundle 对 lib 的依赖为「>= 2.1.11」最小约束，直接顶层引用 3.50.3 满足且优先（nearest-wins），消除 NU1903。
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />
    <!-- 安全修复(NU1903)：DataProtection 传递引入的 System.Security.Cryptography.Xml 10.0.8 有高危漏洞，显式 pin 到已修复的 10.0.10 覆盖传递版本 -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

</Project>
